<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- `IOptions` para a configuração de ambiente de `finance`: série por
         omissão, menção de não-validade fiscal e identificador de consumidor
         final. É abstracção de configuração, não infraestrutura — não traz ORM
         nem framework web. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rivo.Finance.Domain\Rivo.Finance.Domain.csproj" />
    <ProjectReference Include="..\Rivo.Finance.Contracts\Rivo.Finance.Contracts.csproj" />
    <ProjectReference Include="..\..\Audit\Rivo.Audit.Contracts\Rivo.Audit.Contracts.csproj" />
    <ProjectReference Include="..\..\Fiscal\Rivo.Fiscal.Contracts\Rivo.Fiscal.Contracts.csproj" />
    <ProjectReference Include="..\..\Commercial\Rivo.Commercial.Contracts\Rivo.Commercial.Contracts.csproj" />
    <!-- ISupplierDirectory: é por aqui que a factura de compra liga ao
         Fornecedor, em vez de o guardar só como retrato em texto. -->
    <ProjectReference Include="..\..\Procurement\Rivo.Procurement.Contracts\Rivo.Procurement.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

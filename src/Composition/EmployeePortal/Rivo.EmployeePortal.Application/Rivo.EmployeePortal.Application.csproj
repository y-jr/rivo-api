<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Camada de composição (ADR-041), não módulo: sem Domain, sem
    Infrastructure, sem base de dados própria. Depende só do contrato
    publicado de quem compõe.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\Modules\Hr\Rivo.Hr.Contracts\Rivo.Hr.Contracts.csproj" />

    <!--
      Os recibos do próprio (2026-09-07). É a segunda dependência do portal, e
      a razão de ela existir é a mesma da primeira: "o próprio" resolve-se em
      `hr`, e o que se mostra sobre ele vem do módulo que o possui.

      Sem ciclo possível — os `Contracts` não dependem de nada (ADR-017).
    -->
    <ProjectReference Include="..\..\..\Modules\Payroll\Rivo.Payroll.Contracts\Rivo.Payroll.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

# Copiar para `.env` e preencher. O `.env` está em .gitignore e nunca deve
# ser versionado.
#
#   cp .env.example .env
#
# Na VPS, este ficheiro vive em /opt/projects/rivo/.env e é escrito à mão uma
# vez. O deployment (.github/workflows/main.yml) não lhe toca — faz `git pull`
# e sobe os containers, que lêem daqui.

# --- Ambiente ---
# `Production` na VPS. O Swagger só aparece em `Development`.
ASPNETCORE_ENVIRONMENT=Production

# --- Ligação à base de dados ---
# SQL Server externo (ADR-029). Os schemas (identity, audit, hr, documents,
# notifications) são criados pelas migrações no primeiro arranque, e a própria
# base também, se o utilizador tiver permissão para a criar.
#
# Em desenvolvimento, com `docker-compose.dev.yml`, o anfitrião é o serviço do
# compose:
#   Server=sqlserver,1433;Database=rivo;User Id=sa;Password=Rivo_Dev_2026!;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;
CONNECTION_STRING=Server=sqlserver,1433;Database=CHANGE_ME;User Id=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

# --- Migração e seed no arranque ---
# ADR-030 e ADR-028. `MIGRATE_ON_STARTUP=false` obriga a aplicar as migrações
# à mão antes de subir o container — é o que fazer no dia em que houver mais do
# que uma instância.
MIGRATE_ON_STARTUP=true
SEED_ON_STARTUP=true

# Quanto tempo a migração insiste enquanto o servidor não atende. Um SQL Server
# frio demora dezenas de segundos a aceitar ligações.
DATABASE_STARTUP_TIMEOUT_SECONDS=180

# --- Utilizador administrativo inicial ---
# Password: mínimo 12 caracteres, com maiúscula, minúscula, dígito e símbolo.
# Se não cumprir, o arranque falha em vez de deixar o ambiente sem
# administrador.
#
# Estes valores só se aplicam ao arranque de um ambiente novo. Depois de
# criadas, o seed nunca altera as contas nem as passwords (ADR-016).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Utilizador decisor inicial ---
# Nota: nesta fase recebe apenas um Perfil de Acesso. A autoridade de decisão
# prevista em ADR-015 vem do Cargo, que pertence ao módulo `hr`.
BOOTSTRAP_DECIDER_EMAIL=
BOOTSTRAP_DECIDER_PASSWORD=

# --- Chave de assinatura do JWT ---
# Mínimo 32 caracteres. Gerar uma por ambiente; nunca reutilizar entre
# ambientes nem versionar. Ex.: `openssl rand -base64 48`
JWT_SIGNING_KEY=
JWT_ISSUER=rivo-api
JWT_AUDIENCE=rivo-client
JWT_SESSION_LIFETIME_MINUTES=60

# --- Entrega de notificações ---
# Intervalo de sondagem do worker, em segundos.
NOTIFICATION_POLL_INTERVAL_SECONDS=10

# --- Entrar com Google (ADR-032) ---
# OPCIONAL. Sem isto preenchido, POST /identity/login/google responde 501 e
# tudo o resto funciona na mesma — o login por password nao depende daqui.
#
# Vem da Google Cloud Console > APIs & Services > Credentials, como "OAuth 2.0
# Client ID" do tipo Web application. NAO e segredo (viaja no frontend), mas e
# ele que fixa a audiencia esperada do ID token: sem ele, aceitar-se-ia um
# token emitido para outra aplicacao qualquer.
#
# Nao ha ClientSecret: validar uma assinatura precisa da chave publica, e o
# fluxo de redirect que exigiria o segredo foi rejeitado (ADR-032).
#
# O Google so deixa entrar em contas que ja existem no Rivo. Nao cria contas.
GOOGLE_CLIENT_ID=

# --- Origens de browser autorizadas, CORS (ADR-033) ---
# OPCIONAL. Lista separada por virgulas, SEM barra final: o browser compara a
# origem por igualdade textual, e "https://app.rivo.ao/" nunca casa com o
# cabecalho "Origin: https://app.rivo.ao" que ele proprio envia.
#
# Vazio = so um cliente servido no mesmo dominio da API consegue chamar. E a
# configuracao certa se o reverse proxy servir o frontend e a API juntos.
#
# Em desenvolvimento os portos do Vite e do Next ja estao em
# appsettings.Development.json; aqui so e preciso para Docker e producao.
#
# Nao ha credenciais no CORS: o token viaja no cabecalho Authorization, nao em
# cookie (ADR-013).
CORS_ALLOWED_ORIGINS=

# --- Reconciliacao de atribuicoes de cargo aprovadas (ADR-034) ---
# `approval` nao pode empurrar a decisao — nao lhe e permitido modificar dados
# de negocio do modulo de origem. Por isso `hr` pergunta, em ciclo.
#
# Desligado, uma atribuicao aprovada fica pendente ate alguem chamar
# POST /hr/position-assignments/{id}/approval-outcome. E escolha legitima,
# mas tem de ser uma escolha.
POSITION_APPROVAL_RECONCILIATION_ENABLED=true
POSITION_APPROVAL_RECONCILIATION_INTERVAL_SECONDS=60

# --- Facturacao (ADR-036) ---
# A serie de numeracao por omissao. Uma serie continua por tipo de documento,
# sem reinicio anual: reiniciar por ano obrigaria a criar uma serie cada Janeiro
# e a decidir para qual emitir perto da viragem.
#
# O seed abre-a no arranque se ainda nao existir. E idempotente: se ja existir,
# nao lhe toca, e em particular nao lhe recua o contador.
FINANCE_DEFAULT_SERIES=S001
FINANCE_SEED_DEFAULT_SERIES=true

# Mencao impressa na factura enquanto o software nao estiver certificado pela
# AGT. **Congelada na emissao**: esvaziar isto faz as facturas NOVAS sairem sem
# mencao, e as ja emitidas mantem a que lhes foi gravada — que e o correcto,
# porque elas continuam a nao ser validas.
#
# Vazio = sistema certificado. Hoje nenhum ambiente o e.
FINANCE_FISCAL_NOTICE=Documento sem validade fiscal - software nao certificado pela AGT.

# Identificador usado no lugar do NIF numa venda a consumidor final.
#
# ⚠ A convencao angolana para este identificador NAO esta verificada em fonte
# primaria. O valor por omissao e deliberadamente nao-plausivel como NIF: um
# numero com ar de real seria tomado por verificado e sobreviveria ate a
# certificacao. SUBSTITUIR PELO OFICIAL ANTES DE CERTIFICAR.
#
# Vazio bloqueia a venda a consumidor final, com mensagem que diz porque.
FINANCE_FINAL_CONSUMER_TAX_ID=CONSUMIDORFINAL
FINANCE_FINAL_CONSUMER_NAME=Consumidor final

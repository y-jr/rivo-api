<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- `IOptions` para a configuração de ambiente de `finance`: série por
         omissão, menção de não-validade fiscal e identificador de consumidor
         final. É abstracção de configuração, não infraestrutura — não traz ORM
         nem framework web. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rivo.Finance.Domain\Rivo.Finance.Domain.csproj" />
    <ProjectReference Include="..\Rivo.Finance.Contracts\Rivo.Finance.Contracts.csproj" />
    <!-- PageRequest/Pagination (ADR-068) — primitiva estrutural sem dono de
         negócio, não conceito de finance. -->
    <ProjectReference Include="..\..\..\SharedKernel\Rivo.SharedKernel\Rivo.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Audit\Rivo.Audit.Contracts\Rivo.Audit.Contracts.csproj" />
    <!--
      Desde o ADR-057: resolver o colaborador a partir da conta autenticada.

      Sem isto, quem executa um pagamento fica declarado pelo corpo do pedido,
      e o BR-3 verifica-se contra um valor que o próprio chamador escolhe.
      Mesma dependência, e pela mesma razão, que `approval` passou a ter com o
      ADR-050. Sem risco de ciclo: `Rivo.Hr.Contracts` não depende de nada
      (ADR-017).
    -->
    <ProjectReference Include="..\..\Hr\Rivo.Hr.Contracts\Rivo.Hr.Contracts.csproj" />
    <ProjectReference Include="..\..\Fiscal\Rivo.Fiscal.Contracts\Rivo.Fiscal.Contracts.csproj" />
    <ProjectReference Include="..\..\Commercial\Rivo.Commercial.Contracts\Rivo.Commercial.Contracts.csproj" />
    <!-- ISupplierDirectory: é por aqui que a factura de compra liga ao
         Fornecedor, em vez de o guardar só como retrato em texto. -->
    <ProjectReference Include="..\..\Procurement\Rivo.Procurement.Contracts\Rivo.Procurement.Contracts.csproj" />

    <!-- IDocumentCatalogue: o comprovativo de um PaymentClaim é um documento
         anexado, mesmo desenho de `fleet`/`hr` (ADR-009, ADR-044). -->
    <ProjectReference Include="..\..\Documents\Rivo.Documents.Contracts\Rivo.Documents.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

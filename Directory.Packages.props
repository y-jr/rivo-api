<Project>

  <!--
    Gestão central de versões de pacotes.

    Antes disto, cada um dos 26 `.csproj` fixava as suas versões à mão. Ainda
    não tinham divergido — foi por isso que este ficheiro nasceu agora e não
    depois: a correcção é trivial enquanto as versões coincidem, e passa a ser
    arqueologia assim que deixarem de coincidir.

    Com catorze módulos previstos, cada um com cinco projectos, a divergência
    era questão de tempo. E divergência de versões de EF Core ou do provider de SQL Server
    entre módulos não dá erro de compilação — dá comportamento diferente em
    módulos diferentes, que é bastante pior.

    A partir daqui, um `.csproj` declara *que* pacote usa; a versão é decidida
    aqui, num sítio só.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Uma versão declarada num `.csproj` passa a ser erro, e não aviso
      silenciosamente ignorado. Sem isto, um projecto novo podia continuar a
      fixar a sua versão e ninguém dava por isso.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Persistência. -->
  <ItemGroup>
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
  </ItemGroup>

  <!-- Identidade e autenticação. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <!-- Descoberta OIDC e JWKS, para validar o ID token da Google (ADR-032). -->
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <!-- API e documentação. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.6" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <!-- Azure (ADR-027). -->
  <ItemGroup>
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
  </ItemGroup>

  <!-- Testes de integração (ADR-026). -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
  </ItemGroup>

  <!-- Testes (ADR-022). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
